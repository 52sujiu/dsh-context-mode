{
  "name": "dsh-context-mode",
  "version": "0.4.0",
  "description": "Expose context-mode MCP tools as native DeepSeek Harness tools",
  "keywords": [
    "dsh",
    "dsh-tui",
    "context-mode",
    "mcp",
    "context-window",
    "code-execution",
    "fts5"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/52sujiu/dsh-context-mode.git"
  },
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js"
    },
    "./compaction": {
      "types": "./lib/types/compaction.d.ts",
      "import": "./lib/types/compaction.js"
    },
    "./transcript": {
      "types": "./lib/types/transcript.d.ts",
      "import": "./lib/types/transcript.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "scripts/cleanup-injected.mjs",
    "skills",
    "vendor/context-mode/server.bundle.mjs",
    "vendor/context-mode/LICENSE",
    "vendor/context-mode/src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "LICENSING.md"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:server": "node scripts/build-server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm build && pnpm build:server && pnpm smoke",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
